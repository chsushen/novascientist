# NovaScientist Environment Configuration (Optional)
# NovaScientist runs 100% locally on CPU/ARM64 for empirical benchmarking,
# AST auditing, literature extraction, and LaTeX generation with zero API keys required.

# Optional: External LLM API Keys (for custom multi-agent expansions)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Scholarly API Email (polite pool for CrossRef / OpenAlex)
CROSSREF_MAILTO=your_email@university.edu
