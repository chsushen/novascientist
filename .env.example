# ==============================================================================
# NovaScientist v2.3 — Production Environment Configuration
# ==============================================================================

# Application Environment
NOVASCIENTIST_ENV=production
NOVASCIENTIST_DEBUG=false
NOVASCIENTIST_DATA_DIR=.novascientist_data

# API Server
NOVASCIENTIST_HOST=0.0.0.0
NOVASCIENTIST_PORT=8000
NOVASCIENTIST_RATE_LIMIT=60
NOVASCIENTIST_CORS_ORIGINS=*

# LLM Providers (Optional - falls back to deterministic mock if unprovided)
NOVASCIENTIST_LLM_PROVIDER=deterministic_mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
NOVASCIENTIST_LLM_TIMEOUT=45.0
NOVASCIENTIST_LLM_MAX_RETRIES=3
NOVASCIENTIST_LLM_COST_LIMIT_USD=10.0

# Resource & Execution Controls
NOVASCIENTIST_MAX_CONCURRENT_JOBS=4
NOVASCIENTIST_JOB_TIMEOUT=600.0
NOVASCIENTIST_SANDBOX_MAX_MEMORY_MB=1024
NOVASCIENTIST_DEMO_MODE=false
